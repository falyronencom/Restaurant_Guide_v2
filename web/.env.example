# Backend API endpoint. Server-only (NO NEXT_PUBLIC_ prefix per D4).
# Production: set in the Railway service's Variables.
# Local dev: copy this file to .env.local and adjust value if running backend locally.
API_URL=https://restaurantguidev2-production.up.railway.app

# Canonical site base URL (no trailing slash). Server-only — used for
# sitemap absolute URLs, metadataBase, OG image fallback.
# Production: set to the launch domain (e.g. https://nirivio.by).
# Local dev: optional; falls back to http://localhost:3000 when unset.
SITE_URL=http://localhost:3000

# SEO Gate — single env var controlling robots/sitemap/metadata-robots layers.
# Default ON (any value except literal 'false'). Set to 'false' ONLY at the
# launch moment, after verifying SEO surface in staging.
# Flip-off path: set NOINDEX_MODE=false + SITE_URL=<launch-domain> on the
# deploy platform, then redeploy (env vars read at build time).
NOINDEX_MODE=true

# Google OAuth — Web client_id for browser Google Identity Services (GIS).
# Server-only (NO NEXT_PUBLIC_ prefix): read in the root layout and passed as a
# prop into the client AuthProvider. Use the SAME "Web application" client_id as
# the backend's GOOGLE_CLIENT_ID — the id_token `aud` must match what the
# backend verifies. Add http://localhost:3000 (dev) + the deploy origin to that
# OAuth client's Authorized JavaScript origins in Google Cloud.
# Production: set in the Railway service's Variables. Local dev: set in .env.local.
GOOGLE_CLIENT_ID=

# Yandex Static API key — renders the establishment location map (MapPreview).
# Server-only (NO NEXT_PUBLIC_ prefix): read in the MapPreview Server Component
# and baked into the static-map <img> URL. The key DOES reach the browser (it
# rides in the image URL — unavoidable for the Static API), so lock it down in
# the Yandex developer cabinet by HTTP Referer: list the deploy host(s) +
# nirivio.by (+ localhost for dev), one per line, no scheme/port. Without the
# key, MapPreview degrades to a styled address placeholder.
# Production: set in the Railway service's Variables. Local dev: set in .env.local.
YANDEX_MAPS_API_KEY=

# The site's secret towards the API (registry v4.35, directive D5). Server-only
# (NO NEXT_PUBLIC_ prefix). The SAME value as the backend's SITE_REQUEST_SECRET,
# at least 32 characters (a random 32 bytes in base64 is 44). With it the API
# counts each visitor's sign-in attempts and smart-search phrases against the
# visitor (header X-Site-Visitor), not against the whole site. Without it the
# site is one address to the API, as before. Never in chat, files or logs —
# only the password manager and the Railway Variables.
SITE_REQUEST_SECRET=

# Railway hops at the right end of X-Forwarded-For (1-3, default 2): the entry
# left of them is the visitor. Leave unset unless the edge changes — a CDN in
# front of the site adds a hop; the probe is repeated before changing it.
# SITE_TRUST_PROXY_HOPS=2
